{
  "schema_version": 1,
  "project": "website-testing",
  "purpose": "Spec-driven Go HTTP/DNS/TLS/TCP smoke runner with TUI and legacy Bash parity.",
  "actions": [
    {
      "id": "verify",
      "intent": "Execute the complete configured local gate before publishing this repository.",
      "argv": [
        "lefthook",
        "run",
        "pre-push",
        "--force"
      ],
      "effects": [
        "read",
        "local_write",
        "process",
        "network"
      ],
      "acceptance_scope": "fixture",
      "inputs": [
        "lefthook.yml",
        "Makefile",
        "pyproject.toml",
        "uv.lock",
        "_test/smoke.bats",
        "cmd/smoke-go/main.go",
        ".golangci.yml",
        ".mise.toml",
        ".pre-commit-config.yaml",
        "_test/helpers/mocks.bash",
        "_test/run_tests.sh",
        "go.mod",
        "go.sum",
        "internal/adhoc/http.go",
        "internal/adhoc/http_test.go",
        "internal/cli/colors.go",
        "internal/cli/root.go",
        "internal/cli/root_test.go",
        "internal/runner/offline_contract_test.go",
        "internal/runner/runner.go",
        "internal/runner/runner_test.go",
        "internal/spec/marshal_test.go",
        "internal/spec/spec.go",
        "internal/spec/spec_test.go",
        "internal/tui/builder.go",
        "internal/tui/builder_test.go",
        "internal/tui/styles.go",
        "internal/tui/tui.go",
        "scripts/hooks/check-staged-shell.sh",
        "scripts/hooks/check-staged-yaml.sh",
        "scripts/hooks/lib.sh",
        "scripts/hooks/run-local-ci.sh",
        "smoke.sh",
        "_test/local-gate-refusal.bats"
      ],
      "requires": [],
      "recovery": "Read the failed owner job; repair its source or declared prerequisite, then rerun the full local gate. Fixture acceptance does not authorize cloud/device deployment."
    }
  ],
  "learning": [
    {
      "id": "owner-invariant",
      "when": [
        "smoke",
        "target",
        "website",
        "fixture"
      ],
      "summary": "Synthetic targets and process fixtures qualify local CLI behavior; resolving a host or compiling the binary cannot certify a production website state.",
      "owner": "_test/smoke.bats",
      "basis": [
        {
          "path": "_test/smoke.bats",
          "sha256": "d51813516682f404a4a756b6f19c831feb915ed0a9e3b0e5d90df55803365dad"
        },
        {
          "path": "cmd/smoke-go/main.go",
          "sha256": "1afdcd850dfbf12782cf15544a8dee96abaf3875faef799e0f077a371ce834f9"
        }
      ],
      "verify_action": "verify"
    },
    {
      "id": "full-gate-refusal",
      "when": [
        "gate",
        "skip",
        "recursive",
        "verification"
      ],
      "summary": "Skipped or recursive full-gate execution is not acceptance. Execute mode refuses those conditions before effects; preview remains read-only. The required fixture job proves both refusals and the preview control.",
      "owner": "scripts/hooks/run-local-ci.sh",
      "basis": [
        {
          "path": "scripts/hooks/run-local-ci.sh",
          "sha256": "28092235224fd8ff8672d482a2f00d421aa8486419f8b3bcf440630289429a1c"
        },
        {
          "path": "_test/local-gate-refusal.bats",
          "sha256": "6c06336a08316ca5047713e06dd28dc48177d07b48a34942c4f58e62d68a01b4"
        }
      ],
      "verify_action": "verify"
    }
  ]
}
